@@ -0,0 +1,119 @@
+const MAX_ENTRIES = 32
+const MAX_CHARACTERS = 2_097_152
+const documentCaches = new WeakMap()
+let renderQueue = Promise.resolve()
+let nextCopyId = 1
+
+const removeEntry = (cache, key) => {
+  cache.characters -= cache.entries.get(key).characters
+  cache.entries.delete(key)
+}
+
+const trimCache = cache => {
+  while (cache.entries.size > MAX_ENTRIES || cache.characters > MAX_CHARACTERS) {
+    removeEntry(cache, cache.entries.keys().next().value)
+  }
+}
+
+const escapePattern = value => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+
+const escapeSelectorId = value =>
+  Array.from(value, (character, index) => {
+    const code = character.codePointAt(0)
+    if (code === 0) return '\uFFFD'
+    if (
+      code < 32 || code === 127 ||
+      (/[0-9]/.test(character) && (index === 0 || (index === 1 && value[0] === '-')))
+    ) return `\\${code.toString(16)} `
+    if (index === 0 && character === '-' && value.length === 1) return '\\-'
+    return code >= 128 || /[a-zA-Z0-9_-]/.test(character) ? character : `\\${character}`
+  }).join('')
+
+const cloneSvg = (documentRef, template, cacheHit) => {
+  const svg = documentRef.importNode(template, true)
+  const prefix = `file-viewer-mermaid-copy-${Date.now()}-${nextCopyId++}`
+  const ids = new Map()
+  const elements = [svg, ...svg.querySelectorAll('*')]
+  for (const element of elements) {
+    if (!element.id) continue
+    const nextId = `${prefix}-${ids.size}`
+    ids.set(element.id, nextId)
+    element.id = nextId
+  }
+  const replaceUrls = value =>
+    value.replace(/url\(\s*(['"]?)#([^\s'"\)]+)\1\s*\)/g, (match, quote, id) =>
+      ids.has(id) ? `url(${quote}#${ids.get(id)}${quote})` : match
+    )
+  // Mermaid scopes CSS to its root and also emits independently named node IDs.
+  const selectorIds = new Map()
+  for (const [id, nextId] of ids) {
+    const escaped = escapeSelectorId(id)
+    selectorIds.set(escaped, nextId)
+  }
+  const selectorPattern = new RegExp(
+    ids.size
+      ? `#(${[...selectorIds.keys()].sort((a, b) => b.length - a.length).map(escapePattern).join('|')})(?![\\w-])`
+      : '(?!)',
+    'g'
+  )
+  for (const element of elements) {
+    for (const attribute of [...element.attributes]) {
+      if (attribute.name === 'id') continue
+      let value = replaceUrls(attribute.value)
+      if (attribute.localName === 'href' && value.startsWith('#')) {
+        value = ids.has(value.slice(1)) ? `#${ids.get(value.slice(1))}` : value
+      }
+      if (attribute.name === 'aria-labelledby' || attribute.name === 'aria-describedby') {
+        value = value.replace(/\S+/g, id => ids.get(id) || id)
+      }
+      if (value !== attribute.value) element.setAttribute(attribute.name, value)
+    }
+    if (element.localName !== 'style') continue
+    // Restrict ID selector changes to rule preludes; color values stay intact.
+    element.textContent = replaceUrls(element.textContent || '').replace(
+      /([^{}]+)\{/g,
+      (match, selector) =>
+        `${selector.replace(selectorPattern, (_, id) => `#${selectorIds.get(id)}`)}{`
+    )
+  }
+  svg.dataset.diagramCacheHit = String(cacheHit)
+  return svg
+}
+
+// Keep sanitized templates only in memory; each viewer owns its SVG and Panzoom.
+export const renderCachedMermaid = async (documentRef, text, theme, renderTemplate) => {
+  let cache = documentCaches.get(documentRef)
+  if (!cache) {
+    cache = { entries: new Map(), characters: 0 }
+    documentCaches.set(documentRef, cache)
+  }
+  const key = `${theme}\0${text}`
+  const existing = cache.entries.get(key)
+  if (existing) {
+    cache.entries.delete(key)
+    cache.entries.set(key, existing)
+    return cloneSvg(documentRef, await existing.promise, true)
+  }
+  // Mermaid's own queue excludes initialize(), so serialize the whole operation.
+  const promise = renderQueue.then(renderTemplate)
+  renderQueue = promise.then(() => undefined, () => undefined)
+  const entry = { promise, characters: key.length }
+  if (entry.characters <= MAX_CHARACTERS) {
+    cache.entries.set(key, entry)
+    cache.characters += entry.characters
+    trimCache(cache)
+  }
+  try {
+    const template = await promise
+    if (cache.entries.get(key) === entry) {
+      const svgCharacters = template.outerHTML.length
+      entry.characters += svgCharacters
+      cache.characters += svgCharacters
+      trimCache(cache)
+    }
+    return cloneSvg(documentRef, template, false)
+  } catch (error) {
+    if (cache.entries.get(key) === entry) removeEntry(cache, key)
+    throw error
+  }
+}
