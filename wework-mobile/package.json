{
  "name": "wework-mobile",
  "version": "0.1.0",
  "private": true,
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": false
  },
  "main": "index.ts",
  "scripts": {
    "start": "pnpm build:preview && expo start",
    "device": "pnpm build:preview && ./scripts/run-mobile.sh",
    "android": "pnpm build:preview && expo run:android",
    "ios": "pnpm build:preview && expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:android": "pnpm build:preview && expo export --platform android --output-dir dist/android",
    "build:ios": "pnpm build:preview && expo export --platform ios --output-dir dist/ios",
    "build": "pnpm run build:android && pnpm run build:ios",
    "build:preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "2.40.3",
    "@dr.pogodin/react-native-static-server": "0.27.1",
    "@expo/ui": "~57.0.26",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "3.7.2",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@scure/base": "^2.0.0",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.21",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "fflate": "^0.8.3",
    "punycode": "^2.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "prettier": "^3.9.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}
