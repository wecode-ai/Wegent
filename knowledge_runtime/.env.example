# Knowledge Runtime Configuration

# Server configuration
HOST=0.0.0.0
PORT=8200

# Database configuration
# Required for config resolution in query/index/admin paths.
# Use the same database as Backend.
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/task_manager

# Backend URL for fetching content
BACKEND_INTERNAL_URL=http://localhost:8000

# Content fetching timeout in seconds
CONTENT_FETCH_TIMEOUT=120

# Logging configuration
LOG_FILE_ENABLED=true
LOG_DIR=./logs
LOG_LEVEL=INFO

# Internal Service Token for authentication
# Required. All /internal/rag/* endpoints (except health) require this token.
# Must match Backend's INTERNAL_SERVICE_TOKEN.
# Generate using: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# Attachment encryption configuration
# When ATTACHMENT_ENCRYPTION_ENABLED=true in Backend, attachments are encrypted
# before storage. knowledge_runtime needs the same keys to decrypt during indexing.
# Keys must match Backend's ATTACHMENT_AES_KEY and ATTACHMENT_AES_IV
# Generate using: openssl rand -hex 16 (for 32-byte key) and openssl rand -hex 8 (for 16-byte IV)
ATTACHMENT_AES_KEY=12345678901234567890123456789012
ATTACHMENT_AES_IV=1234567890123456

# -----------------------------------------------------------------------------
# KB statistics configuration
# -----------------------------------------------------------------------------
# Master switch for the KB-stat HTTP layer. When false, all /internal/kb-stat/*
# endpoints (except /health) return 503. Beat scheduling lives on the backend.
# KB_STAT_ENABLED=true

# Independent switch for the weekly prune task. Mirrors backend
# KB_STAT_PRUNE_ENABLED — kept in sync so /health can report the effective
# retain-forever mode from one place. The actual beat removal happens on the
# backend (it owns celery beat).
# KB_STAT_PRUNE_ENABLED=true

# KB-stat Celery worker subprocess (consuming the kb_stat queue).
# Set to false to stop collection without disabling the HTTP API.
# KB_STAT_WORKER_ENABLED=true

# Run `alembic upgrade head` on startup. Default false — manage migrations
# explicitly in production deployments.
# KB_STAT_AUTO_MIGRATE=false

# Collection window (days) — how far back each run reads from the source DB.
# Default 30. The daily beat passes lookback_days=1 explicitly (incremental);
# this default applies to manual triggers and backfills.
# KNOWLEDGE_STAT_LOOKBACK_DAYS=30
# KB_STAT_PIPELINE_MODE=legacy

# Retention (days) — runs older than this are pruned by the weekly task.
# Default 400 (~13 months). Set <=0 ONLY when KB_STAT_PRUNE_ENABLED=false:
# the runner short-circuits prune when retention_days<=0, but setting it
# to 0 alone (without disabling prune) would delete almost all history
# (cutoff = today). See tmp/kb-stat-analysis-and-plan.md §7.6.
# KNOWLEDGE_STAT_RETENTION_DAYS=400

# Comma-separated domains to collect (empty = all). Useful for running a
# subset after a collector change.
# KB_STAT_DOMAINS=

# Minutes before a stuck "running" run is auto-marked failed.
# KB_STAT_STALE_MINUTES=120

# TTL (seconds) of the per-target_date collection lock. Must exceed the
# celery task time_limit (default 1800s).
# KB_STAT_LOCK_TTL_SECONDS=1800

# Dedicated stat DB (falls back to DATABASE_URL when empty). Recommended
# in production so analytics queries don't compete with chat latency.
# KNOWLEDGE_STAT_DATABASE_URL=

# Business DB read replica used by collectors (falls back to DATABASE_URL).
# Strongly recommended in production — collectors scan subtask_contexts,
# which is latency-sensitive for chat.
# DATABASE_READONLY_URL=
