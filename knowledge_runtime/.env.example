# Knowledge Runtime Configuration

# Runtime settings use KNOWLEDGE_RUNTIME_*; unprefixed names remain supported.
# Server configuration
KNOWLEDGE_RUNTIME_HOST=0.0.0.0
KNOWLEDGE_RUNTIME_PORT=8200

# Database configuration
# Required for config resolution in query/index/admin paths.
# Use the same database as Backend.
KNOWLEDGE_RUNTIME_DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/task_manager

# Credential decryption for referenced models and retrievers.
# Must match Backend's GIT_TOKEN_AES_KEY and GIT_TOKEN_AES_IV.
GIT_TOKEN_AES_KEY=
GIT_TOKEN_AES_IV=

# Content fetching timeout in seconds
KNOWLEDGE_RUNTIME_CONTENT_FETCH_TIMEOUT=120

# Logging configuration
KNOWLEDGE_RUNTIME_LOG_FILE_ENABLED=true
KNOWLEDGE_RUNTIME_LOG_DIR=./logs
KNOWLEDGE_RUNTIME_LOG_LEVEL=INFO

# Internal Service Token for authentication
# Required. All /internal/rag/* endpoints (except health) require this token.
# Must match Backend's INTERNAL_SERVICE_TOKEN.
# Generate using: openssl rand -hex 32
KNOWLEDGE_RUNTIME_INTERNAL_SERVICE_TOKEN=

# Attachment encryption configuration
# When ATTACHMENT_ENCRYPTION_ENABLED=true in Backend, attachments are encrypted
# before storage. knowledge_runtime needs the same keys to decrypt during indexing.
# Keys must match Backend's ATTACHMENT_AES_KEY and ATTACHMENT_AES_IV
# Generate using: openssl rand -hex 16 (for 32-byte key) and openssl rand -hex 8 (for 16-byte IV)
ATTACHMENT_AES_KEY=12345678901234567890123456789012
ATTACHMENT_AES_IV=1234567890123456
