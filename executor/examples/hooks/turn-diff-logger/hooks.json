{
  "TurnStarted": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "./bin/log-turn.mjs",
          "commandWindows": "./bin/log-turn.cmd",
          "timeout": 300,
          "async": true
        }
      ]
    }
  ],
  "TurnCompleted": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "./bin/log-turn.mjs",
          "commandWindows": "./bin/log-turn.cmd",
          "timeout": 300,
          "async": true
        }
      ]
    }
  ],
  "ExecutionCompleted": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "./bin/log-turn.mjs",
          "commandWindows": "./bin/log-turn.cmd",
          "timeout": 300,
          "async": true
        }
      ]
    }
  ]
}
