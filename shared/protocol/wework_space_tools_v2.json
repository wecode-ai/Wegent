    {
      "name": "list_spaces",
      "description": "List project spaces accessible to the current user with pagination and explicit source references. Restore unavailable connections through wework_space, never by substituting Git or provider APIs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string"
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
