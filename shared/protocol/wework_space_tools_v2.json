              "type": "object",
              "properties": {
                "type": {
                  "enum": ["user", "agent", "group", "team"]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["type", "id"],
              "additionalProperties": false
            }
          },
          "unassigned": {
            "type": "boolean"
          },
          "participation": {
            "const": "mine",
            "description": "Only Issues the authenticated user participated in."
          },
          "creator_user_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclude_statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "priorities": {
            "type": "array",
            "items": {
              "enum": ["none", "low", "medium", "high", "urgent"]
            }
          },
          "tags": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": ["any", "all"]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["mode", "values"],
            "additionalProperties": false
          },
          "parent": {
            "type": "object",
            "properties": {
              "space": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "project_store": {
                        "const": "backend"
                      },
                      "space_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["project_store", "space_id"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "project_store": {
                        "const": "local"
                      },
                      "space_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "device_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["project_store", "space_id", "device_id"],
                    "additionalProperties": false
                  }
                ]
              },
              "item_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["space", "item_id"],
            "additionalProperties": false
          },
          "has_children": {
            "type": "boolean"
          },
          "created_at": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "updated_at": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "due_at": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "include_archived": {
            "type": "boolean"
          },
          "projection": {
            "enum": ["summary", "detail"]
          },
          "sort": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "enum": [
                    "id",
                    "title",
                    "created_at",
                    "updated_at",
                    "due_at",
                    "priority",
                    "status"
                  ]
                },
                "direction": {
                  "enum": ["asc", "desc"]
                }
              },
              "required": ["field", "direction"],
              "additionalProperties": false
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          },
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "continuation_cursor": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [],
        "additionalProperties": false
      }
