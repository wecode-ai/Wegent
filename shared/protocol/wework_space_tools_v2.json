                        {
                          "type": "object",
                          "properties": {
                            "project_store": {
                              "const": "local"
                            },
                            "space_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "device_id": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "project_store",
                            "space_id",
                            "device_id"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "minItems": 1
                  }
                },
                "required": ["kind", "spaces"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "workspace"
                  },
                  "workspace_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["kind", "workspace_id"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "accessible"
                  }
                },
                "required": ["kind"],
                "additionalProperties": false
              }
            ]
          },
          "query": {
            "type": "string"
          },
          "assignees": {
            "type": "array",
