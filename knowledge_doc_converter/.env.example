# Backend callback
BACKEND_BASE_URL=http://backend:8000
# Required. Must match Backend's INTERNAL_SERVICE_TOKEN.
BACKEND_INTERNAL_TOKEN=

# Redis Password (applied to all Redis URLs when set; empty = no password authentication)
# REDIS_PASSWORD=

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Redis (distributed lock)
REDIS_URL=redis://redis:6379/0

# Knowledge event reporting (Kafka). Disabled is a no-op and creates no producer.
EVENT_REPORTING_ENABLED=false
# Required when event reporting is enabled. Separate multiple brokers with commas.
EVENT_KAFKA_BOOTSTRAP_SERVERS=
EVENT_KAFKA_TOPIC=knowledge-events-v1
# Required when enabled, for example: dev, staging, or production.
EVENT_KAFKA_ENVIRONMENT=
# Leave unset to generate a converter-specific client ID automatically.
# EVENT_KAFKA_CLIENT_ID=
EVENT_KAFKA_ACKS=all
EVENT_KAFKA_COMPRESSION_TYPE=lz4
EVENT_KAFKA_LINGER_MS=20
EVENT_KAFKA_REQUEST_TIMEOUT_MS=5000
EVENT_KAFKA_DELIVERY_TIMEOUT_MS=5000
EVENT_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
EVENT_KAFKA_SASL_MECHANISM=PLAIN
EVENT_KAFKA_SASL_USERNAME=
EVENT_KAFKA_SASL_PASSWORD=
EVENT_KAFKA_SSL_CAFILE=
EVENT_KAFKA_QUEUE_MAX_BYTES=16777216
EVENT_KAFKA_EVENT_MAX_BYTES=8192
EVENT_KAFKA_SHUTDOWN_TIMEOUT_MS=8000

# Distributed Lock
KNOWLEDGE_CONVERSION_LOCK_TIMEOUT_SECONDS=12000
KNOWLEDGE_CONVERSION_LOCK_EXTEND_INTERVAL_SECONDS=60
KNOWLEDGE_CONVERSION_LOCK_MAX_RETRIES=2
KNOWLEDGE_CONVERSION_LOCK_RETRY_DELAY_SECONDS=30

# MinerU
MINERU_API_BASE_URL=http://mineru:8888
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=ocr
MINERU_LANG_LIST=ch
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_MAX_WAIT_SECONDS=3000
MINERU_SUBMIT_TIMEOUT_SECONDS=60
MINERU_STATUS_TIMEOUT_SECONDS=10
MINERU_DOWNLOAD_TIMEOUT_SECONDS=120
MINERU_MAX_CONSECUTIVE_ERRORS=5
MINERU_ERROR_RETRY_INTERVAL_SECONDS=3

# S3 (image upload)
WORKER_CONVERSION_S3_ENABLED=false
WORKER_CONVERSION_S3_ENDPOINT=
WORKER_CONVERSION_S3_ACCESS_KEY=
WORKER_CONVERSION_S3_SECRET_KEY=
WORKER_CONVERSION_S3_BUCKET_NAME=
WORKER_CONVERSION_S3_REGION_NAME=us-east-1

# Task Timeout
# Constraint: soft_time_limit < time_limit < lock_timeout <= stale_threshold (backend)
CONVERSION_TASK_SOFT_TIME_LIMIT=9000
CONVERSION_TASK_TIME_LIMIT=10000

# Logging
LOG_FILE_ENABLED=true
LOG_DIR=./logs
LOG_LEVEL=INFO

# Prometheus Metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics
