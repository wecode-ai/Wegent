{
  "name": "@wegent/dsh-plugin-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./connections": {
      "types": "./connections.d.ts",
      "default": "./connections.js"
    },
    "./connection-dependencies": "./connection-dependencies.js",
    "./connection-http": {
      "types": "./connection-http.d.ts",
      "default": "./connection-http.js"
    },
    "./web-connection-provider": "./web-connection-provider.js",
    "./web-connection-package": "./web-connection-package.js",
    "./connection-tools": "./connection-tools.js",
    "./connection-runtime": "./connection-runtime.js",
    "./connection-observations": "./connection-observations.js",
    "./cloud-observations": "./cloud-observations.js"
  },
  "files": [
    "cordis.patch.yml",
    "index.d.ts",
    "index.js",
    "connections.js",
    "connections.d.ts",
    "connection-dependencies.js",
    "connection-http.js",
    "connection-http.d.ts",
    "web-connection-provider.js",
    "web-connection-package.js",
    "connection-tools.js",
    "connection-runtime.js",
    "event-bus.js",
    "connection-observations.js",
    "cloud-observations.js",
    "connection-schema.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dependencies": {
    "semver": "7.8.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
