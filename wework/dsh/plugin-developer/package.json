{
  "name": "@wegent/dsh-wework-plugin-developer",
  "displayName": "Wework 插件开发",
  "description": "Creates and debugs Wework Core DSH plugins.",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "wework": {
    "codexPlugin": "./codex-plugin"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@wegent/dsh-app-wework"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2"
  }
}
