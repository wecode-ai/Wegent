{
  "name": "@wegent/dsh-sidebar-browser-panel-demo",
  "displayName": "Sidebar Browser Panel",
  "description": "Opens a website beside the current Wework workspace.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@wegent/dsh-app-wework"
      ],
      "platform": "web"
    }
  },
  "files": [
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "index.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2"
  }
}
