{
  "name": "@wegent/dsh-connection-git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@wegent/dsh-connection-host": "0.1.0",
    "@wegent/dsh-executor-runtime": "0.1.0"
  },
  "wework": {
    "connections": {
      "apiVersion": 1,
      "dependencies": {},
      "providers": [
        {
          "id": "github",
          "displayName": "GitHub",
          "uses": [],
          "collectionModes": [
            "poll"
          ],
          "resourceKinds": [
            "personal",
            "repository"
          ],
          "resourceLabels": {
            "personal": "个人全部事件",
            "repository": "只关注某个仓库"
          },
          "eventTypes": [
            "git.event"
          ],
          "versionedEventTypes": [
            "git.event"
          ],
          "authTarget": {
            "pluginKey": "github",
            "connectorSlug": "wework-github-cli"
          },
          "locales": {
            "en": {
              "displayName": "GitHub",
              "resourceLabels": {
                "personal": "All personal events",
                "repository": "Follow a specific repository"
              }
            }
          },
          "resourceQuerySchema": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "description": "HTTPS origin of the user-selected GitHub instance. Ask when the intended instance is unknown."
              },
              "search": {
                "type": "string",
                "description": "Optional repository search text."
              }
            },
            "required": [
              "instance"
            ]
          }
        },
        {
          "id": "gitlab",
          "displayName": "GitLab",
          "uses": [],
          "collectionModes": [
            "poll"
          ],
          "resourceKinds": [
            "personal",
            "repository"
          ],
          "resourceLabels": {
            "personal": "个人全部事件",
            "repository": "只关注某个仓库"
          },
          "eventTypes": [
            "git.event"
          ],
          "versionedEventTypes": [
            "git.event"
          ],
          "locales": {
            "en": {
              "displayName": "GitLab",
              "resourceLabels": {
                "personal": "All personal events",
                "repository": "Follow a specific repository"
              }
            }
          },
          "resourceQuerySchema": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "description": "HTTPS origin of the user-selected GitLab instance. Ask when the intended instance is unknown."
              },
              "search": {
                "type": "string",
                "description": "Optional repository search text."
              }
            },
            "required": [
              "instance"
            ]
          }
        }
      ]
    }
  }
}
