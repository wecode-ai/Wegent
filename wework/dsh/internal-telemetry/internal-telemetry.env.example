# Optional overrides for Wework's internal PostHog telemetry plugin.
# The internal distribution enables telemetry by default.
# Set this to false only as an emergency kill switch.
# WEWORK_INTERNAL_TELEMETRY_ENABLED=false
#
# WEWORK_INTERNAL_TELEMETRY_POSTHOG_HOST=https://posthog.intra.weibo.com
# WEWORK_INTERNAL_TELEMETRY_POSTHOG_PROJECT_KEY=phc_your_project_token
# WEWORK_INTERNAL_TELEMETRY_ALLOW_HTTP_POSTHOG_HOST=
# Optional: only used to hash legacy numeric user IDs when no cloud email prefix is available.
WEWORK_INTERNAL_TELEMETRY_IDENTITY_HMAC_KEY=
WEWORK_INTERNAL_TELEMETRY_RELEASE_CHANNEL=development
WEWORK_INTERNAL_TELEMETRY_BATCH_SIZE=20
WEWORK_INTERNAL_TELEMETRY_FLUSH_INTERVAL_MS=5000
WEWORK_INTERNAL_TELEMETRY_MAX_QUEUE_SIZE=500
WEWORK_INTERNAL_TELEMETRY_REQUEST_TIMEOUT_MS=5000
