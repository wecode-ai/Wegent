WEWORK_INTERNAL_TELEMETRY_ENABLED=false
WEWORK_INTERNAL_TELEMETRY_POSTHOG_HOST=https://posthog.invalid
WEWORK_INTERNAL_TELEMETRY_ALLOW_HTTP_POSTHOG_HOST=
WEWORK_INTERNAL_TELEMETRY_POSTHOG_PROJECT_KEY=replace-at-deploy-time
