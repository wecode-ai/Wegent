{
  "name": "@wegent/dsh-app-wework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@wegent/dsh-electron-host"
      ],
      "platform": "web"
    }
  },
  "files": [
    "client.js",
    "client.d.ts",
    "cordis.patch.yml",
    "index.js",
    "web"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@wegent/dsh-electron-host": "0.1.0"
  }
}
