diff --git a/out/WeworkUpdateBaseline.js b/out/WeworkUpdateBaseline.js
new file mode 100644
index 0000000000000000000000000000000000000000..e036bb24a45910bcae74218b484705b5ed2d4283
--- /dev/null
+++ b/out/WeworkUpdateBaseline.js
@@ -0,0 +1,44 @@
+"use strict";
+const fs = require('fs-extra');
+const path = require('path');
+const crypto = require('crypto');
+const { createReadStream } = require('fs');
+const { pipeline } = require('stream/promises');
+const { gunzipSync } = require('zlib');
+async function hashFile(file, algorithm, encoding) {
+    const hash = crypto.createHash(algorithm);
+    await pipeline(createReadStream(file), hash);
+    return hash.digest(encoding);
+}
+async function readBaseline(root, arch) {
+    try {
+        const record = await fs.readJson(path.join(root, 'wework-baseline.json'));
+        if (record.schemaVersion !== 1 || record.platform !== process.platform || record.arch !== arch) return null;
+        const bytes = await fs.readFile(path.join(root, 'current.blockmap'));
+        if (crypto.createHash('sha256').update(bytes).digest('hex') !== record.blockmapSha256) return null;
+        if (await hashFile(path.join(root, 'update.zip'), 'sha512', 'base64') !== record.sha512) return null;
+        return { record, blockmap: JSON.parse(gunzipSync(bytes).toString()) };
+    } catch (error) {
+        if (error.code === 'EACCES' || error.code === 'EPERM') throw error;
+        return null;
+    }
+}
+async function saveBaseline(root, file, blockmap, info) {
+    if (await hashFile(file, 'sha512', 'base64') !== info.sha512) throw new Error('Wework baseline ZIP checksum mismatch');
+    JSON.parse(gunzipSync(blockmap).toString());
+    await fs.ensureDir(root);
+    const marker = path.join(root, 'wework-baseline.json');
+    await fs.remove(marker);
+    const zip = path.join(root, 'update.zip');
+    const map = path.join(root, 'current.blockmap');
+    await fs.copyFile(file, `${zip}.tmp`);
+    await fs.writeFile(`${map}.tmp`, blockmap);
+    await fs.rename(`${zip}.tmp`, zip);
+    await fs.rename(`${map}.tmp`, map);
+    await fs.outputJson(`${marker}.tmp`, {
+        ...info, schemaVersion: 1, platform: process.platform,
+        blockmapSha256: crypto.createHash('sha256').update(blockmap).digest('hex'),
+    });
+    await fs.rename(`${marker}.tmp`, marker);
+}
+module.exports = { readBaseline, saveBaseline };
