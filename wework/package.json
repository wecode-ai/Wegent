{
  "name": "wework",
  "private": true,
  "version": "0.3.6-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:electron": "node scripts/prepare-electron.mjs",
    "dev:desktop": "pnpm run prepare:electron && pnpm --dir electron dev",
    "dev:mac": "bash scripts/dev-mac-app.sh",
    "dev:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-windows-app.ps1",
    "prepare:codex": "node scripts/prepare-codex-binary.mjs",
    "prepare:dws": "node scripts/prepare-dws-binary.mjs",
    "prepare:harness-runtime": "node scripts/prepare-harness-runtime.mjs",
    "build:dsh-app": "vite build --base /wework/app/ --outDir dsh/app-wework/web --emptyOutDir",
    "build": "tsc -b && vite build",
    "build:desktop": "pnpm run ai:verify:electron:build",
    "build:release": "pnpm run prepare:electron && pnpm --dir electron build:release",
    "build:mac": "pnpm run build:desktop",
    "build:windows": "pnpm run build:desktop",
    "build:mac:devtools": "WEWORK_RELEASE_DEVTOOLS=1 pnpm run build:desktop",
    "lint": "eslint . && pnpm run lint:typography && pnpm run lint:task-lifecycle",
    "lint:typography": "node scripts/check-typography.mjs",
    "lint:task-lifecycle": "node scripts/check-runtime-task-lifecycle.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "node scripts/run-vitest.mjs",
    "test:watch": "vitest",
    "test:kimi-k3-profile": "node scripts/verify-kimi-k3-profile.mjs",
    "e2e": "playwright test",
    "e2e:desktop": "node e2e/desktop/run-checkpoints.mjs",
    "e2e:desktop:cloud": "node e2e/desktop/run-checkpoints.mjs --cloud-only",
    "e2e:desktop:cloud-features": "node e2e/desktop/run-checkpoints.mjs --cloud-features-only",
    "e2e:desktop:cloud-vision": "node e2e/desktop/run-checkpoints.mjs --cloud-vision-only",
    "e2e:desktop:plugins": "node e2e/desktop/run-checkpoints.mjs --plugins-only",
    "e2e:desktop:memory": "node e2e/desktop/run-checkpoints.mjs --memory-only",
    "e2e:desktop:embedded-browser": "node e2e/desktop/run-checkpoints.mjs --segment embedded-browser",
    "e2e:desktop:browser-toolbar-actions": "node e2e/desktop/run-checkpoints.mjs --segment browser-toolbar-actions",
    "e2e:desktop:local-terminal": "node e2e/desktop/run-checkpoints.mjs --segment local-harness",
    "e2e:desktop:streaming-text": "node e2e/desktop/run-checkpoints.mjs --segment rendering-extensions",
    "ai:verify": "node scripts/ai-verify.mjs",
    "ai:verify:electron:prepare": "node scripts/prepare-ai-verify-electron.mjs",
    "ai:verify:electron:build": "node scripts/build-ai-verify-electron.mjs",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@blocknote/core": "0.52.1",
    "@blocknote/mantine": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@chenglou/pretext": "0.0.8",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@dagrejs/dagre": "^3.0.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@file-viewer/preset-engineering": "2.1.26",
    "@file-viewer/preset-lite": "2.1.26",
    "@file-viewer/preset-office": "2.1.26",
    "@file-viewer/react": "2.1.26",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@pierre/diffs": "^1.2.11",
    "@pierre/trees": "1.0.0-beta.4",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/react": "^8.55.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "3.14.2",
    "@wegent/chat-core": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "ag-grid-community": "^36.0.2",
    "ag-grid-react": "^36.0.2",
    "archiver": "8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dequal": "2.0.3",
    "extract-zip": "2.0.1",
    "highlight.js": "11.11.1",
    "html2canvas": "1.4.1",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "3.10.1",
    "lucide-react": "^1.16.0",
    "lz-string": "1.5.0",
    "mermaid": "11.15.0",
    "plantuml-encoder": "1.4.0",
    "posthog-js": "^1.409.5",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.10",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "semver": "7.8.5",
    "streamdown": "2.5.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@file-viewer/vite-plugin": "2.1.26",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "8.0.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "dingtalk-workspace-cli": "1.0.58",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.19",
    "tar": "^7.5.20",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write",
      "eslint --fix",
      "node scripts/check-typography.mjs"
    ]
  }
}
