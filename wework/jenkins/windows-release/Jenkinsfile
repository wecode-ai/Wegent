pipeline {
  agent {
    label 'windows'
  }

  parameters {
    string(
      name: 'VERSION',
      defaultValue: '',
      description: 'Release version, for example 1.2.3 or 1.2.4-beta.1'
    )
    string(
      name: 'BRANCH',
      defaultValue: 'develop',
      description: 'Git branch, tag, or commit to build'
    )
    booleanParam(
      name: 'BETA',
      defaultValue: false,
      description: 'Publish to the beta update channel'
    )
    booleanParam(
      name: 'UPLOAD',
      defaultValue: false,
      description: 'Upload the verified release assets to MinIO'
    )
    text(
      name: 'CHANGE_LOG',
      defaultValue: '',
      description: 'Optional release notes'
    )
  }

  environment {
    ComSpec = 'C:\\Windows\\System32\\cmd.exe'
    PNPM_HOME = 'C:\\Users\\video\\AppData\\Roaming\\npm'
    CARGO_HOME = 'C:\\Users\\video\\.cargo'
    RUSTUP_HOME = 'C:\\Users\\video\\.rustup'
    POWERSHELL_HOME = 'C:\\Users\\video\\.local\\powershell\\7.6.5'
    PATH = 'C:\\Windows\\System32;C:\\Windows\\System32\\WindowsPowerShell\\v1.0;C:\\Program Files\\Git\\cmd;C:\\Program Files\\Git\\bin;C:\\Program Files\\nodejs;C:\\Users\\video\\AppData\\Roaming\\npm;C:\\Users\\video\\.cargo\\bin;C:\\Users\\video\\.local\\bin;C:\\Users\\video\\.local\\powershell\\7.6.5'
  }

  options {
    skipDefaultCheckout(true)
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 2, unit: 'HOURS')
  }

  stages {
    stage('Prepare Windows environment') {
      steps {
        bat '''
@echo off
setlocal

node -e "const major=Number(process.versions.node.split('.')[0]); if(process.platform!=='win32'||process.arch!=='x64'||major!==24){console.error('Expected Windows x64 Node.js 24, received', process.platform, process.arch, process.version); process.exit(1)}"
if errorlevel 1 exit /b %errorlevel%

if not exist "%PNPM_HOME%\\pnpm.cmd" (
  echo pnpm was not found at %PNPM_HOME%\\pnpm.cmd
  exit /b 1
)

call "%PNPM_HOME%\\pnpm.cmd" --version > "%TEMP%\\wework-pnpm-version.txt"
if errorlevel 1 exit /b %errorlevel%
set /p PNPM_VERSION=<"%TEMP%\\wework-pnpm-version.txt"
del "%TEMP%\\wework-pnpm-version.txt"
if not "%PNPM_VERSION%"=="11.7.0" (
  echo Expected pnpm 11.7.0, received %PNPM_VERSION%
  exit /b 1
)

where uv >nul 2>&1
if errorlevel 1 (
  echo uv was not found on PATH
  exit /b 1
)

if not exist "%POWERSHELL_HOME%\\pwsh.exe" (
  echo PowerShell 7 was not found at %POWERSHELL_HOME%\\pwsh.exe
  exit /b 1
)

"%POWERSHELL_HOME%\\pwsh.exe" -NoLogo -NoProfile -Command "$PSVersionTable.PSVersion.ToString()"
if errorlevel 1 exit /b %errorlevel%

if not exist "%CARGO_HOME%\\bin\\rustup.exe" (
  echo rustup was not found at %CARGO_HOME%\\bin\\rustup.exe
  exit /b 1
)

"%CARGO_HOME%\\bin\\rustup.exe" show active-toolchain
if errorlevel 1 exit /b %errorlevel%

"%CARGO_HOME%\\bin\\rustc.exe" -vV > "%TEMP%\\wework-rustc-version.txt"
if errorlevel 1 exit /b %errorlevel%

%SystemRoot%\\System32\\findstr.exe /c:"host: x86_64-pc-windows-msvc" "%TEMP%\\wework-rustc-version.txt" >nul
if errorlevel 1 (
  echo Expected Rust host x86_64-pc-windows-msvc, received:
  type "%TEMP%\\wework-rustc-version.txt"
  del "%TEMP%\\wework-rustc-version.txt"
  exit /b 1
)
del "%TEMP%\\wework-rustc-version.txt"

"%CARGO_HOME%\\bin\\cargo.exe" -V
if errorlevel 1 exit /b %errorlevel%

if not exist "C:\\Program Files\\Git\\bin\\bash.exe" (
  echo Git Bash was not found at C:\\Program Files\\Git\\bin\\bash.exe
  exit /b 1
)

if not exist "%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe" (
  echo Visual Studio Installer vswhere.exe was not found
  exit /b 1
)
'''
      }
    }

    stage('Checkout') {
      steps {
        deleteDir()
        checkout(
          changelog: false,
          poll: false,
          scm: [
            $class: 'GitSCM',
            branches: [[name: params.BRANCH.trim()]],
            userRemoteConfigs: [[
              credentialsId: 'wegent-git-credentials',
              url: 'https://git.intra.weibo.com/weibo_rd/common/wecode/wegent.git'
            ]]
          ]
        )
      }
    }

    stage('Resolve release') {
      steps {
        script {
          def releaseVersion = params.VERSION.trim()
          def stableVersion = ~/^[0-9]+\.[0-9]+\.[0-9]+$/
          def betaVersion = ~/^[0-9]+\.[0-9]+\.[0-9]+-beta\.[1-9][0-9]*$/

          if (params.BETA && !(releaseVersion ==~ betaVersion)) {
            error("Beta releases require x.y.z-beta.N, received: ${releaseVersion}")
          }
          if (!params.BETA && !(releaseVersion ==~ stableVersion)) {
            error("Stable releases require x.y.z, received: ${releaseVersion}")
          }

          env.RELEASE_VERSION = releaseVersion
          env.RELEASE_CHANNEL = params.BETA ? 'beta' : 'stable'
          env.SOURCE_SHA = bat(
            returnStdout: true,
            script: '@git rev-parse HEAD'
          ).trim()
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${releaseVersion} windows-x64"
          currentBuild.description =
            "${env.RELEASE_CHANNEL} ${env.SOURCE_SHA.take(12)} upload=${params.UPLOAD}"
        }

        bat '''
@echo off
if not exist .jenkins-release mkdir .jenkins-release
'''
        writeFile(
          file: '.jenkins-release/notes.txt',
          text: params.CHANGE_LOG ?: ''
        )
      }
    }

    stage('Install dependencies') {
      steps {
        bat '''
@echo off
call pnpm install --frozen-lockfile
exit /b %errorlevel%
'''
      }
    }

    stage('Build unsigned Windows release') {
      steps {
        withCredentials([
          string(
            credentialsId: 'wegent-s3-endpoint',
            variable: 'ATTACHMENT_S3_ENDPOINT'
          ),
          string(
            credentialsId: 'wegent-s3-bucket',
            variable: 'ATTACHMENT_S3_BUCKET'
          ),
          string(
            credentialsId: 'wegent-s3-access-key',
            variable: 'ATTACHMENT_S3_ACCESS_KEY'
          ),
          string(
            credentialsId: 'wegent-s3-secret-key',
            variable: 'ATTACHMENT_S3_SECRET_KEY'
          ),
          string(
            credentialsId: 'wegent-s3-region',
            variable: 'ATTACHMENT_S3_REGION'
          ),
          string(
            credentialsId: 'wegent-s3-use-ssl',
            variable: 'ATTACHMENT_S3_USE_SSL'
          )
        ]) {
          writeFile(
            file: '.jenkins-release/build.sh',
            text: '''#!/usr/bin/env bash
set -euo pipefail

args=(
  --version "$RELEASE_VERSION"
  --channel "$RELEASE_CHANNEL"
  --unsigned
)

if [ -s .jenkins-release/notes.txt ]; then
  args+=(--notes "$(cat .jenkins-release/notes.txt)")
fi

if [ "${UPLOAD:-false}" = "true" ]; then
  args+=(--upload)
fi

bash wework/scripts/build-minio-windows-release.sh "${args[@]}"
'''
          )
          writeFile(
            file: '.jenkins-release/run-build.cmd',
            text: '''@echo off
setlocal

set "VSWHERE=%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe"
for /f "usebackq tokens=*" %%I in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VS_INSTALL=%%I"

if not defined VS_INSTALL (
  echo Visual Studio C++ Build Tools were not found
  exit /b 1
)

call "%VS_INSTALL%\\Common7\\Tools\\VsDevCmd.bat" -arch=x64 -host_arch=x64
if errorlevel 1 exit /b %errorlevel%

set "MSVC_LINKER=%VCToolsInstallDir%bin\\Hostx64\\x64\\link.exe"
if exist "%MSVC_LINKER%" goto msvc_linker_ready
echo Visual Studio MSVC linker was not found at %MSVC_LINKER%
exit /b 1

:msvc_linker_ready
set "CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER=%MSVC_LINKER%"
echo Using MSVC linker: %CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER%

"C:\\Program Files\\Git\\bin\\bash.exe" .jenkins-release/build.sh
exit /b %errorlevel%
'''
          )

          bat 'call .jenkins-release\\run-build.cmd'
        }
      }
    }

    stage('Verify Electron updater artifacts') {
      steps {
        writeFile(
          file: '.jenkins-release/verify-release.mjs',
          text: '''import { readFile, stat } from 'node:fs/promises'
import { resolve } from 'node:path'

const version = process.env.RELEASE_VERSION
const channel = process.env.RELEASE_CHANNEL
const output = resolve('wework/electron/release-minio')
const installerName = `WeWork_${version}_windows-x64-setup.exe`
const hostUpdateName = `WeWorkHostUpdate_${version}_windows-x64-setup.exe`
const installer = resolve(output, installerName)
const componentManifestPath = resolve(output, `components-${channel}-windows-x64.json`)
const electronManifest = resolve(output, `${channel === 'stable' ? 'latest' : 'beta'}.yml`)

for (const path of [
  installer,
  `${installer}.blockmap`,
  resolve(output, hostUpdateName),
  resolve(output, `${hostUpdateName}.blockmap`),
  componentManifestPath,
  electronManifest,
]) {
  const file = await stat(path).catch(() => null)
  if (!file?.isFile() || file.size === 0) {
    throw new Error(`Required Windows release artifact is missing or empty: ${path}`)
  }
}

const componentManifest = JSON.parse(await readFile(componentManifestPath, 'utf8'))
if (
  componentManifest.appVersion !== version ||
  componentManifest.channel !== channel ||
  componentManifest.platform !== 'windows' ||
  componentManifest.arch !== 'x64'
) {
  throw new Error('The Windows component updater manifest is inconsistent.')
}

const electron = await readFile(electronManifest, 'utf8')
if (!electron.includes(installerName) && !electron.includes(hostUpdateName)) {
  throw new Error('The Electron Windows updater manifest does not reference an update package.')
}

console.log(`Verified Windows Electron updater artifacts for ${version} (${channel}).`)
'''
        )

        bat 'node .jenkins-release\\verify-release.mjs'
      }
    }

    stage('Archive') {
      steps {
        archiveArtifacts(
          artifacts: 'wework/electron/release-minio/**',
          fingerprint: true
        )
      }
    }
  }

  post {
    always {
      deleteDir()
    }
  }
}
