    {
      "description": {
        "zh-CN": "用户进入智能工作台市场入口",
        "en": "The user enters the Smart App marketplace"
      },
      "eventSchemaVersion": 1,
      "key": "smart_app.marketplace",
      "kind": "route",
      "match": {
        "pathname": "/sites",
        "query": { "app_type": "smart_app" },
        "queryNot": { "view": "owned" }
      },
      "name": "smart_app_marketplace_opened",
      "properties": [{ "name": "domain", "type": "enum", "values": ["smart_app"] }],
      "title": { "zh-CN": "打开智能工作台市场", "en": "Open Smart App marketplace" }
    },
    {
      "description": {
        "zh-CN": "用户进入我的智能工作台",
        "en": "The user enters owned Smart Apps"
      },
      "eventSchemaVersion": 1,
      "key": "smart_app.owned",
      "kind": "route",
      "match": { "pathname": "/sites", "query": { "app_type": "smart_app", "view": "owned" } },
      "name": "smart_app_owned_opened",
      "properties": [{ "name": "domain", "type": "enum", "values": ["smart_app"] }],
      "title": { "zh-CN": "打开我的智能工作台", "en": "Open owned Smart Apps" }
    },
