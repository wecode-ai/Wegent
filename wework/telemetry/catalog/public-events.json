{
  "schemaVersion": 1,
  "domain": "smart_app",
  "owner": "wework/harness-apps",
  "events": [
    {
      "description": {
        "zh-CN": "用户进入智能工作台市场入口",
        "en": "The user enters the Smart App marketplace"
      },
      "eventSchemaVersion": 1,
      "key": "smart_app.marketplace",
      "kind": "route",
      "match": {
        "pathname": "/sites",
        "query": { "app_type": "smart_app" },
        "queryNot": { "view": "owned" }
      },
      "name": "smart_app_marketplace_opened",
      "properties": [{ "name": "domain", "type": "enum", "values": ["smart_app"] }],
      "title": { "zh-CN": "打开智能工作台市场", "en": "Open Smart App marketplace" }
    },
    {
      "description": {
        "zh-CN": "用户进入我的智能工作台",
        "en": "The user enters owned Smart Apps"
      },
      "eventSchemaVersion": 1,
      "key": "smart_app.owned",
      "kind": "route",
      "match": { "pathname": "/sites", "query": { "app_type": "smart_app", "view": "owned" } },
      "name": "smart_app_owned_opened",
      "properties": [{ "name": "domain", "type": "enum", "values": ["smart_app"] }],
      "title": { "zh-CN": "打开我的智能工作台", "en": "Open owned Smart Apps" }
    },
    {
      "description": { "zh-CN": "用户打开一个智能工作台", "en": "The user opens a Smart App" },
      "eventSchemaVersion": 1,
      "key": "smart_app.app",
      "kind": "route",
      "match": { "pathnamePrefix": "/app/harness-" },
      "name": "smart_app_opened",
      "properties": [{ "name": "domain", "type": "enum", "values": ["smart_app"] }],
      "title": { "zh-CN": "打开智能工作台", "en": "Open Smart App" }
    },
    {
      "description": { "zh-CN": "用户安装智能工作台", "en": "The user installs a Smart App" },
      "eventSchemaVersion": 1,
      "key": "smart_app.install",
      "kind": "operation",
      "name": "smart_app_install_succeeded",
      "operation": "install",
      "outcome": "succeeded",
      "properties": [{ "name": "domain", "type": "enum", "values": ["smart_app"] }],
      "title": { "zh-CN": "安装智能工作台", "en": "Install Smart App" }
    },
    {
      "description": { "zh-CN": "用户安装智能工作台", "en": "The user installs a Smart App" },
      "eventSchemaVersion": 1,
      "failureStages": ["download", "validate", "install", "confirm"],
      "key": "smart_app.install",
      "kind": "operation",
      "name": "smart_app_install_failed",
      "operation": "install",
      "outcome": "failed",
      "properties": [
        { "name": "domain", "type": "enum", "values": ["smart_app"] },
        {
          "name": "failure_stage",
          "type": "enum",
          "values": ["download", "validate", "install", "confirm"]
        }
      ],
      "title": { "zh-CN": "安装智能工作台", "en": "Install Smart App" }
    },
    {
      "description": { "zh-CN": "用户更新智能工作台", "en": "The user updates a Smart App" },
      "eventSchemaVersion": 1,
      "key": "smart_app.update",
      "kind": "operation",
      "name": "smart_app_update_succeeded",
      "operation": "update",
      "outcome": "succeeded",
      "properties": [{ "name": "domain", "type": "enum", "values": ["smart_app"] }],
      "title": { "zh-CN": "更新智能工作台", "en": "Update Smart App" }
    },
    {
      "description": { "zh-CN": "用户更新智能工作台", "en": "The user updates a Smart App" },
      "eventSchemaVersion": 1,
      "failureStages": ["download", "validate", "install", "confirm"],
      "key": "smart_app.update",
      "kind": "operation",
      "name": "smart_app_update_failed",
      "operation": "update",
      "outcome": "failed",
      "properties": [
        { "name": "domain", "type": "enum", "values": ["smart_app"] },
        {
          "name": "failure_stage",
          "type": "enum",
          "values": ["download", "validate", "install", "confirm"]
        }
      ],
      "title": { "zh-CN": "更新智能工作台", "en": "Update Smart App" }
    },
    {
      "description": {
        "zh-CN": "用户导入智能工作台 ZIP",
        "en": "The user imports a Smart App ZIP"
      },
      "eventSchemaVersion": 1,
      "key": "smart_app.zip_import",
      "kind": "operation",
      "name": "smart_app_zip_import_succeeded",
      "operation": "zip_import",
      "outcome": "succeeded",
      "properties": [{ "name": "domain", "type": "enum", "values": ["smart_app"] }],
      "title": { "zh-CN": "导入智能工作台 ZIP", "en": "Import Smart App ZIP" }
    },
    {
      "description": {
        "zh-CN": "用户导入智能工作台 ZIP",
        "en": "The user imports a Smart App ZIP"
      },
      "eventSchemaVersion": 1,
      "failureStages": ["preview", "validate", "install", "confirm"],
      "key": "smart_app.zip_import",
      "kind": "operation",
      "name": "smart_app_zip_import_failed",
      "operation": "zip_import",
      "outcome": "failed",
      "properties": [
        { "name": "domain", "type": "enum", "values": ["smart_app"] },
        {
          "name": "failure_stage",
          "type": "enum",
          "values": ["preview", "validate", "install", "confirm"]
        }
      ],
      "title": { "zh-CN": "导入智能工作台 ZIP", "en": "Import Smart App ZIP" }
    }
  ],
  "operationDefinitions": [
    {
      "action": "install",
      "failureStages": ["download", "validate", "install", "confirm"],
      "key": "smart_app.install"
    },
    {
      "action": "update",
      "failureStages": ["download", "validate", "install", "confirm"],
      "key": "smart_app.update"
    },
    {
      "action": "zip_import",
      "failureStages": ["preview", "validate", "install", "confirm"],
      "key": "smart_app.zip_import"
    }
  ],
  "routeDefinitions": [
    {
      "eventName": "smart_app_marketplace_opened",
      "key": "smart_app.marketplace",
      "match": {
        "pathname": "/sites",
        "query": { "app_type": "smart_app" },
        "queryNot": { "view": "owned" }
      }
    },
    {
      "eventName": "smart_app_owned_opened",
      "key": "smart_app.owned",
      "match": { "pathname": "/sites", "query": { "app_type": "smart_app", "view": "owned" } }
    },
    {
      "eventName": "smart_app_opened",
      "key": "smart_app.app",
      "match": { "pathnamePrefix": "/app/harness-" }
    }
  ]
}
