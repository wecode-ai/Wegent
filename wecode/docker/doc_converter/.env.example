# Knowledge Doc Converter Configuration

# Backend callback
BACKEND_BASE_URL=http://backend:8000
BACKEND_INTERNAL_TOKEN=0d5e0bd60ce75e583697aeda5b1324dd

# Celery
CELERY_BROKER_URL=redis://:fpxsHjf3m0Bh4SIA@rm48958.eos.grid.sina.com.cn:48958/0
CELERY_RESULT_BACKEND=redis://:fpxsHjf3m0Bh4SIA@rm48958.eos.grid.sina.com.cn:48958/0

# Redis (distributed lock)
REDIS_URL=redis://:fpxsHjf3m0Bh4SIA@rm48958.eos.grid.sina.com.cn:48958/0

# Distributed Lock
KNOWLEDGE_CONVERSION_LOCK_TIMEOUT_SECONDS=12000
KNOWLEDGE_CONVERSION_LOCK_EXTEND_INTERVAL_SECONDS=60
KNOWLEDGE_CONVERSION_LOCK_MAX_RETRIES=2
KNOWLEDGE_CONVERSION_LOCK_RETRY_DELAY_SECONDS=30

# MinerU
MINERU_API_BASE_URL=http://127.0.0.1:8000
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=ocr
MINERU_LANG_LIST=ch
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_MAX_WAIT_SECONDS=3000

# S3 (image upload)
WORKER_CONVERSION_S3_ENABLED=false
WORKER_CONVERSION_S3_ENDPOINT=http://s3.hj4.1.intra.weibo.com:9100
WORKER_CONVERSION_S3_ACCESS_KEY=DJN4uY5UJRcVK2bSJ8gA
WORKER_CONVERSION_S3_SECRET_KEY=sxPTdqlVdoRpKQjGVrpcnrcVLTssQthCzVnrX0TV
WORKER_CONVERSION_S3_BUCKET_NAME=wegent
WORKER_CONVERSION_S3_REGION_NAME=us-east-1

# Task Timeout
# Constraint: soft_time_limit < time_limit < lock_timeout <= stale_threshold (backend)
CONVERSION_TASK_SOFT_TIME_LIMIT=9000
CONVERSION_TASK_TIME_LIMIT=10000

# Logging
LOG_FILE_ENABLED=true
LOG_DIR=/data1/weibo/logs
LOG_LEVEL=INFO

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

MULTIMODAL_ENABLED=true
# Celery queue for multimodal tasks. The worker must consume it — start with:
#   --queues=knowledge_conversion,knowledge_multimodal_conversion
MULTIMODAL_QUEUE=knowledge_multimodal_conversion
# Image size threshold: ≤ this → inline base64; > this → GCS gs://
MULTIMODAL_INLINE_MAX_BYTES=20971520
# Image absolute size cap (bytes). Exceeding → rejected (aligns with GCS upload_simple 100MB limit)
MULTIMODAL_IMAGE_MAX_BYTES=104857600
# Gemini output token budgets (video scenes are longer than single images)
MULTIMODAL_VIDEO_GEMINI_MAX_OUTPUT_TOKENS=8192
MULTIMODAL_IMAGE_GEMINI_MAX_OUTPUT_TOKENS=4096
MULTIMODAL_GEMINI_TEMPERATURE=0.2
# Task timeouts. Decorator uses the larger VIDEO values (Celery limits are per-task,
# not per-message); image enforces a shorter soft deadline internally.
MULTIMODAL_TASK_SOFT_TIME_LIMIT=1800
MULTIMODAL_TASK_TIME_LIMIT=2000
MULTIMODAL_IMAGE_SOFT_TIME_LIMIT=300
# Download timeouts (video CDN vs image attachment endpoint)
MULTIMODAL_DOWNLOAD_TIMEOUT_SECONDS=300
MULTIMODAL_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=120
# Streaming download chunk size (bytes, ~1 MiB peak memory)
MULTIMODAL_DOWNLOAD_CHUNK_BYTES=1048576
MULTIMODAL_RETRY_MAX=1
MULTIMODAL_RETRY_COUNTDOWN_SECONDS=60
