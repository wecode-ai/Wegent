tAsia="Microsoft YaHei" w:cs="Arial"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>的模拟考卷。你可以按环节顺序向我提问/汇报进展，我会作为"考官"给出反馈和评分意见。</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:sz="6" w:space="1" w:color="14B8A6"/></w:pBdr></w:pPr></w:p><w:p/><w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:sz="6" w:space="1" w:color="DCDCDC"/></w:pBdr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:eastAsia="Microsoft YaHei" w:cs="Arial"/><w:b/><w:color w:val="24292E"/><w:sz w:val="28"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>一、考试说明</w:t></w:r></w:p><w:p/><w:tbl><w:tblPr><w:tblStyle w:val="LightGrid-Accent1"/><w:tblW w:type="auto" w:w="0"/><w:tblLook w:firstColumn="1" w:firstRow="1" w:lastColumn="0" w:lastRow="0" w:noHBand="0" w:noVBand="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="4320"/><w:gridCol w:w="4320"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>项目</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>内容</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:t>题型</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:t>1道大题，6个连续环节（层层递进，前一环节结果是后一环节输入）</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:t>建议用时</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:t>150分钟（环节耗时分配见下表）</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:t>使用工具</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:t>仅限内部AI工具（WeiboAP / Wegent）</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:t>评分重点</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:t>任务拆解能力、数据处理逻辑、AI协作过程真实性、结果可用性</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:t>特别提醒</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4320"/></w:tcPr><w:p><w:r><w:t>报告中涉及互动类指标时，**不要止步于"曝光量、互动量"等行为层数据**，需进一步分析这些互动是否转化为实际业务价值（如种草转化、搜索行为、加购/成交等），这是本次考核报告环节的隐性加分项</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p/><w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:sz="6" w:space="1" w:color="14B8A6"/></w:pBdr></w:pPr></w:p><w:p/><w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:sz="6" w:space="1" w:color="DCDCDC"/></w:pBdr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:eastAsia="Microsoft YaHei" w:cs="Arial"/><w:b/><w:color w:val="24292E"/><w:sz w:val="28"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>二、大题背景（考试场景设定）</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:ind w:left="720"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:eastAsia="Microsoft YaHei" w:cs="Arial"/><w:i/><w:color w:val="6A737D"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>你是某新锐美妆品牌的产品运营，负责监测品牌自有微博账号「@XX品牌官方」以及2个竞品账号的内容表现，需要在一次营销活动期间（近7天）完成"抓取—监测—报告—推送—封装—可视化"的完整闭环，形成一套可复用的</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:eastAsia="Microsoft YaHei" w:cs="Arial"/><w:b/><w:i/><w:color w:val="6A737D"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>日常监测工作流</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:eastAsia="Microsoft YaHei" w:cs="Arial"/><w:i/><w:color w:val="6A737D"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>，供团队后续持续使用。</w:t></w:r></w:p><w:p/><w:p><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:eastAsia="Microsoft YaHei" w:cs="Arial"/><w:b/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>给定信息（可自行合理假设并说明假设依据）：</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:eastAsia="Microsoft YaHei" w:cs="Arial"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>监