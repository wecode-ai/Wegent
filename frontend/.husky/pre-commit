#!/usr/bin/env sh

# Get the project root directory
PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

# =============================================================================
# Python Code Formatting Auto-fix (black + isort)
# =============================================================================

# Get staged Python files. Keep one path per line so spaces and glob characters
# remain part of the formatter argument.
PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')

# Function to format Python files in a specific module directory
format_python_module() {
  MODULE_DIR="$1"
  MODULE_FILES="$2"
  MODULE_NAME="$3"

  if [ -z "$MODULE_FILES" ]; then
    return 0
  fi

  echo "  📦 Formatting $MODULE_NAME files..."
  cd "$MODULE_DIR" || return 1

  ABSOLUTE_FILES=$(
    printf '%s\n' "$MODULE_FILES" |
      while IFS= read -r file; do
        [ -n "$file" ] && printf '%s/%s\n' "$PROJECT_ROOT" "$file"
      done
  )

  MODULE_VENV_BIN="$MODULE_DIR/.venv/bin"
  FALLBACK_VENV_BIN="$PROJECT_ROOT/backend/.venv/bin"

  BLACK_CMD=""
  ISORT_CMD=""

  if [ -x "$MODULE_VENV_BIN/black" ]; then
    BLACK_CMD="$MODULE_VENV_BIN/black"
  elif [ -x "$FALLBACK_VENV_BIN/black" ]; then
    BLACK_CMD="$FALLBACK_VENV_BIN/black"
  fi

  if [ -x "$MODULE_VENV_BIN/isort" ]; then
    ISORT_CMD="$MODULE_VENV_BIN/isort"
  elif [ -x "$FALLBACK_VENV_BIN/isort" ]; then
    ISORT_CMD="$FALLBACK_VENV_BIN/isort"
  fi

  # Prefer already-installed formatter binaries to avoid uv environment
  # resolution during git hooks. Only use uv when no installed binary exists;
  # an installed formatter failure must fail the hook instead of selecting a
  # fallback.
  if [ -n "$BLACK_CMD" ]; then
    if ! printf '%s\n' "$ABSOLUTE_FILES" | xargs -I '{}' "$BLACK_CMD" '{}'; then
      echo "    ❌ Black formatting failed for $MODULE_NAME"
      return 1
    fi
  elif command -v uv >/dev/null 2>&1 && uv run black --version >/dev/null 2>&1; then
    if ! printf '%s\n' "$ABSOLUTE_FILES" | xargs -I '{}' uv run black '{}'; then
      echo "    ❌ Black formatting failed for $MODULE_NAME"
      return 1
    fi
  else
    echo "    ❌ Black is unavailable for $MODULE_NAME"
    return 1
  fi
  echo "    ✅ Black formatting applied for $MODULE_NAME"

  if [ -n "$ISORT_CMD" ]; then
    if ! printf '%s\n' "$ABSOLUTE_FILES" | xargs -I '{}' "$ISORT_CMD" '{}'; then
      echo "    ❌ isort formatting failed for $MODULE_NAME"
      return 1
    fi
  elif command -v uv >/dev/null 2>&1 && uv run isort --version >/dev/null 2>&1; then
    if ! printf '%s\n' "$ABSOLUTE_FILES" | xargs -I '{}' uv run isort '{}'; then
      echo "    ❌ isort formatting failed for $MODULE_NAME"
      return 1
    fi
  else
    echo "    ❌ isort is unavailable for $MODULE_NAME"
    return 1
  fi
  echo "    ✅ isort formatting applied for $MODULE_NAME"

  cd "$PROJECT_ROOT" || return 1
}

if [ -n "$PYTHON_FILES" ]; then
  echo "🐍 Formatting Python files with black and isort..."

  BACKEND_FILES=$(printf '%s\n' "$PYTHON_FILES" | grep '^backend/' || true)
  EXECUTOR_FILES=$(printf '%s\n' "$PYTHON_FILES" | grep '^executor/' || true)
  EXECUTOR_MANAGER_FILES=$(
    printf '%s\n' "$PYTHON_FILES" | grep '^executor_manager/' || true
  )
  SHARED_FILES=$(printf '%s\n' "$PYTHON_FILES" | grep '^shared/' || true)
  CHAT_SHELL_FILES=$(printf '%s\n' "$PYTHON_FILES" | grep '^chat_shell/' || true)
  OTHER_FILES=$(
    printf '%s\n' "$PYTHON_FILES" |
      grep -Ev '^(backend|executor|executor_manager|shared|chat_shell)/' || true
  )

  # Format files in each module with its own pyproject.toml context.
  if [ -n "$BACKEND_FILES" ] && [ -f "$PROJECT_ROOT/backend/pyproject.toml" ]; then
    format_python_module "$PROJECT_ROOT/backend" "$BACKEND_FILES" "backend" || exit 1
  fi

  if [ -n "$EXECUTOR_FILES" ] && [ -f "$PROJECT_ROOT/executor/pyproject.toml" ]; then
    format_python_module "$PROJECT_ROOT/executor" "$EXECUTOR_FILES" "executor" || exit 1
  fi

  if [ -n "$EXECUTOR_MANAGER_FILES" ] &&
    [ -f "$PROJECT_ROOT/executor_manager/pyproject.toml" ]; then
    format_python_module \
      "$PROJECT_ROOT/executor_manager" \
      "$EXECUTOR_MANAGER_FILES" \
      "executor_manager" || exit 1
  fi

  if [ -n "$SHARED_FILES" ] && [ -f "$PROJECT_ROOT/shared/pyproject.toml" ]; then
    format_python_module "$PROJECT_ROOT/shared" "$SHARED_FILES" "shared" || exit 1
  fi

  if [ -n "$CHAT_SHELL_FILES" ] && [ -f "$PROJECT_ROOT/chat_shell/pyproject.toml" ]; then
    format_python_module "$PROJECT_ROOT/chat_shell" "$CHAT_SHELL_FILES" "chat_shell" || exit 1
  fi

  # For other files, use backend as the repository-level formatter context.
  if [ -n "$OTHER_FILES" ] && [ -f "$PROJECT_ROOT/backend/pyproject.toml" ]; then
    format_python_module "$PROJECT_ROOT/backend" "$OTHER_FILES" "other" || exit 1
  fi

  # Return to project root
  cd "$PROJECT_ROOT" || exit 1

  # Re-add the formatted files to staging
  if ! printf '%s\n' "$PYTHON_FILES" | xargs -I '{}' git add -- '{}'; then
    echo "❌ Failed to stage formatted Python files"
    exit 1
  fi
fi

# =============================================================================
# Frontend Code Formatting Check (lint-staged)
# =============================================================================

# Check if there are staged frontend files
FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^frontend/' || true)

if [ -n "$FRONTEND_FILES" ]; then
  # Ensure we're in the correct directory for frontend
  cd "$PROJECT_ROOT" || exit 1
  if [ ! -f "package.json" ] || ! grep -q '"name": "wecode-ai-assistant"' package.json 2>/dev/null; then
    if [ -d "frontend" ]; then
      cd frontend || exit 1
    else
      echo "Error: Cannot locate frontend directory"
      exit 1
    fi
  fi

  # Run lint-staged
  npx lint-staged

  # Run Translation Checks
  # Run Translation Checks
  echo "🌍 Checking translations..."
  # We use the script relative to project root
  TRANSLATION_CHECK_SCRIPT="frontend/scripts/find-missing-translations.js"
  
  # Ensure we run from project root to resolve paths correctly
  cd "$PROJECT_ROOT" || exit 1
  
  if node "$TRANSLATION_CHECK_SCRIPT"; then
     : # Success
  else
     echo "❌ Translation check failed. Please resolve before committing."
     exit 1
  fi
fi

# =============================================================================
# Wework Code Formatting Check (lint-staged)
# =============================================================================

WEWORK_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^wework/' || true)

if [ -n "$WEWORK_FILES" ]; then
  echo "🦀 Running wework pre-commit checks..."

  cd "$PROJECT_ROOT/wework" || exit 1
  npx lint-staged
  cd "$PROJECT_ROOT" || exit 1

  echo "✅ Wework pre-commit checks passed"
fi

# =============================================================================
# Alembic Multi-Head Detection
# =============================================================================

# Check if there are staged alembic migration files
ALEMBIC_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/alembic/versions/' || true)

if [ -n "$ALEMBIC_FILES" ]; then
  echo "🔍 Checking Alembic migrations for multiple heads..."

  # Run the alembic head detection script
  ALEMBIC_CHECK_SCRIPT="$PROJECT_ROOT/scripts/hooks/check-alembic-heads.sh"

  if [ -x "$ALEMBIC_CHECK_SCRIPT" ]; then
    if ! "$ALEMBIC_CHECK_SCRIPT"; then
      echo "❌ Alembic multi-head check failed. Please resolve before committing."
      exit 1
    fi
  else
    echo "⚠️ Alembic check script not found or not executable: $ALEMBIC_CHECK_SCRIPT"
  fi
fi
